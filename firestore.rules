rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security and schema validation
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAppointment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.serviceName is string && data.serviceName.size() <= 128 &&
             data.date is string && data.date.size() <= 32 &&
             data.timeSlot is string && data.timeSlot.size() <= 32 &&
             data.status is string && data.status.size() <= 32 &&
             data.intakeForm is map;
    }

    function isValidSettings(data) {
      return data.businessName is string && data.businessName.size() <= 128;
    }

    // Appointments collection: Public clients can create their bookings;
    // Real-time synchronization reads and updates are permitted with validation
    match /appointments/{appointmentId} {
      allow get, list: if isValidId(appointmentId);
      allow create: if isValidId(appointmentId) && isValidAppointment(incoming());
      allow update: if isValidId(appointmentId) && isValidAppointment(incoming());
      allow delete: if isValidId(appointmentId);
    }

    // Settings collection: Studio configuration (hours, buffers, policies)
    match /settings/{settingId} {
      allow get, list: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && isValidSettings(incoming());
      allow delete: if false;
    }
  }
}
